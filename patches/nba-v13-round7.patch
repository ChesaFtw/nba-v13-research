diff --git a/scripts/odds_coverage_audit.py b/scripts/odds_coverage_audit.py
new file mode 100644
index 0000000..79400cb
--- /dev/null
+++ b/scripts/odds_coverage_audit.py
@@ -0,0 +1,89 @@
+"""Per-season coverage audit for opening game odds (and optionally props). Diagnosis only.
+
+For each season it separates the possible causes of "no pregame line":
+  games_without_tip_time      the game index lacks 'datetime' (pre-tip check impossible)
+  games_without_any_row       the API returned no opening row for that game
+  games_with_only_post_tip    rows exist but every row opened at/after tip
+  games_with_pregame_row      usable
+and reports opening lead-time quantiles (hours before tip) plus price completeness.
+
+python -m scripts.odds_coverage_audit --season 2023 --games games_2023.jsonl --odds opening_2023.jsonl \
+   --season 2024 --games ... --odds ... --out research_results/coverage/game_odds_coverage.json
+"""
+import argparse, json
+from collections import Counter, defaultdict
+from pathlib import Path
+
+import numpy as np
+
+from v13.pricing import parse_utc, pregame_status, tip_times
+
+
+def read(p):
+    return [json.loads(x) for x in Path(p).open() if x.strip()]
+
+
+def audit_season(games, rows, kind="game"):
+    regular = [g for g in games if g.get("postseason") is False or g.get("postseason") is None]
+    tips = tip_times(regular)
+    ids = {str(g["id"]) for g in regular}
+    by_game = defaultdict(list)
+    foreign = 0
+    for r in rows:
+        gid = str(r.get("game_id"))
+        if gid in ids:
+            by_game[gid].append(r)
+        else:
+            foreign += 1
+    status_games = Counter()
+    leads, row_status = [], Counter()
+    priced = Counter()
+    for gid in ids:
+        rs = by_game.get(gid, [])
+        if gid not in tips:
+            status_games["games_without_tip_time"] += 1
+        if not rs:
+            status_games["games_without_any_row"] += 1
+            continue
+        st = [pregame_status(r.get("opened_at"), tips.get(gid)) for r in rs]
+        row_status.update(st)
+        if "pregame" in st:
+            status_games["games_with_pregame_row"] += 1
+        elif all(s == "post_tip" for s in st):
+            status_games["games_with_only_post_tip"] += 1
+        else:
+            status_games["games_with_only_unverifiable"] += 1
+        for r, s in zip(rs, st):
+            if s == "pregame":
+                leads.append((tips[gid] - parse_utc(r["opened_at"])).total_seconds() / 3600)
+            if kind == "game":
+                priced["rows_with_spread_price"] += r.get("spread_home_odds") is not None and r.get("spread_away_odds") is not None
+                priced["rows_with_total_price"] += r.get("total_over_odds") is not None and r.get("total_under_odds") is not None
+            else:
+                m = r.get("market") or {}
+                priced["rows_with_two_sided_price"] += m.get("over_odds") is not None and m.get("under_odds") is not None
+    q = np.percentile(leads, [5, 25, 50, 75, 95]).round(1).tolist() if leads else None
+    return {"regular_games": len(ids), "rows": len(rows), "rows_for_other_games": foreign,
+            **dict(status_games), "row_status": dict(row_status), **dict(priced),
+            "pregame_lead_hours_p5_p25_p50_p75_p95": q,
+            "vendors": dict(Counter(str(r.get("vendor")) for rs in by_game.values() for r in rs))}
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--season", type=int, action="append", required=True)
+    p.add_argument("--games", action="append", required=True)
+    p.add_argument("--odds", action="append", required=True)
+    p.add_argument("--kind", choices=("game", "prop"), default="game")
+    p.add_argument("--out", required=True)
+    a = p.parse_args()
+    if not len(a.season) == len(a.games) == len(a.odds):
+        raise SystemExit("Give --season/--games/--odds once per season")
+    report = {str(s): audit_season(read(g), read(o), a.kind) for s, g, o in zip(a.season, a.games, a.odds)}
+    Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+    Path(a.out).write_text(json.dumps(report, indent=2) + "\n")
+    print(json.dumps(report, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/prereg_v2_market.py b/scripts/prereg_v2_market.py
new file mode 100644
index 0000000..46e1a37
--- /dev/null
+++ b/scripts/prereg_v2_market.py
@@ -0,0 +1,82 @@
+"""Frozen procedure replication for one prop market on an untouched season (v2 pipeline).
+
+Runs scripts.backtest_prop_holdout_v2.evaluate EXACTLY as configured in code (within-season
+65/35 split, inner 70/30 validation, EDGE_GRID/EV_GRID, >=40 validation bets, actual prices,
+strict pre-tip lines), takes the named market + selector holdout ledger, and grades it under
+multiplicative AND power de-vig with a mechanical verdict. Nothing is chosen by this script.
+
+python -m scripts.prereg_v2_market --market rebounds --selector edge --features props_2024.jsonl \
+  --lines opening_props_2024.jsonl --games games_2024.jsonl --out research_results/prereg/rebounds_2024.json
+"""
+import argparse, json, math
+from pathlib import Path
+
+from scripts.backtest_prop_holdout_v2 import evaluate
+from v13.pricing import no_vig_pair, power_devig_pair, profit_per_unit, wilson
+
+RULE = {"min_bets": 150, "min_roi_pct": 0.0, "min_excess": 0.02, "min_z": 2.0, "min_priced_share": 0.9}
+
+
+def read(p):
+    return [json.loads(x) for x in Path(p).open() if x.strip()]
+
+
+def grade(ledger):
+    d = [b for b in ledger if b["outcome"] in ("win", "loss")]
+    n = len(d); w = sum(b["outcome"] == "win" for b in d)
+    out = {"bets": len(ledger), "decided": n, "wins": w, "losses": n - w, "pushes": len(ledger) - n,
+           "hit_rate": round(w / n, 4) if n else None, "hit_95ci": wilson(w, n)}
+    if not n:
+        return out
+    out["roi_actual_price_pct"] = round(100 * sum(profit_per_unit(b["price"]) if b["outcome"] == "win" else -1
+                                                  for b in d) / n, 2)
+    for name, fn in (("multiplicative", no_vig_pair), ("power", power_devig_pair)):
+        ps = [fn(b["over_odds"], b["under_odds"])[0 if b["side"] == "over" else 1] for b in d]
+        exp, var = sum(ps), sum(p * (1 - p) for p in ps)
+        out[name] = {"expected_hit_rate": round(exp / n, 4), "excess": round((w - exp) / n, 4),
+                     "z": round((w - exp) / math.sqrt(var), 2) if var > 0 else None}
+    return out
+
+
+def run(features, lines, games, market, selector):
+    rep = evaluate(features, lines, games, "actual")
+    m = rep["markets"].get(market) or {}
+    if m.get("status") != "evaluated" or not isinstance(m.get(selector), dict) or "holdout_ledger" not in m[selector]:
+        return {"verdict": "UNTESTABLE", "reason": f"pipeline did not evaluate {market}/{selector}", "detail": m,
+                "coverage": rep.get("coverage")}
+    ledger = m[selector]["holdout_ledger"]
+    cov = rep.get("coverage", {})
+    dropped = cov.get("line_post_tip", 0) + cov.get("line_unverifiable", 0)
+    priced_share = rep.get("rows_with_both_prices", 0) / max(1, rep.get("matched_rows", 0))
+    primary = grade(ledger)
+    checks = {
+        "bets_ge_150": primary["decided"] >= RULE["min_bets"],
+        "roi_gt_0": (primary.get("roi_actual_price_pct") is not None and primary["roi_actual_price_pct"] > RULE["min_roi_pct"]),
+        "excess_ge_2pts_multiplicative": (primary.get("multiplicative") or {}).get("excess", -1) >= RULE["min_excess"],
+        "excess_ge_2pts_power": (primary.get("power") or {}).get("excess", -1) >= RULE["min_excess"],
+        "z_ge_2_multiplicative": ((primary.get("multiplicative") or {}).get("z") or -9) >= RULE["min_z"],
+        "z_ge_2_power": ((primary.get("power") or {}).get("z") or -9) >= RULE["min_z"],
+    }
+    verdict = "UNTESTABLE" if priced_share < RULE["min_priced_share"] else ("PASS" if all(checks.values()) else "FAIL")
+    return {"verdict": verdict, "market": market, "selector": selector, "rule": RULE, "checks": checks,
+            "frozen_threshold": m[selector]["threshold"], "holdout_start": rep.get("holdout_start"),
+            "priced_share": round(priced_share, 4), "lines_dropped_not_pregame": dropped, "coverage": cov,
+            "primary": primary,
+            "secondary_by_side": {s: grade([b for b in ledger if b["side"] == s]) for s in ("over", "under")},
+            "validation_block": m[selector]["validation"]}
+
+
+def main():
+    p = argparse.ArgumentParser()
+    for k in ("market", "selector", "features", "lines", "games", "out"):
+        p.add_argument(f"--{k}", required=True)
+    a = p.parse_args()
+    res = run(read(a.features), read(a.lines), read(a.games), a.market, a.selector)
+    Path(a.out).parent.mkdir(parents=True, exist_ok=True)
+    Path(a.out).write_text(json.dumps(res, indent=2) + "\n")
+    print(json.dumps(res, indent=2))
+    print(f"VERDICT: {res['verdict']}")
+
+
+if __name__ == "__main__":
+    main()
