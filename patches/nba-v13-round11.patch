+import math
+import random
+from datetime import date, timedelta
+
+import pytest
+
+from v13.matchup_features import build, parse_height
+from v13.provenance import UnverifiedOddsError, quarantine
+
+
+def test_parse_height():
+    assert parse_height("6-11") == 83 and parse_height(None) is None and parse_height("x") is None
+
+
+def league(seed=0, market_knows_size=False, effect=0.25, days=170):
+    """8 teams x 8 players; rebounds rise with height advantage over the opponent's size."""
+    rng = random.Random(seed)
+    teams = {t: [(t * 100 + k, rng.randint(74, 86), rng.uniform(0.15, 0.35)) for k in range(8)] for t in range(1, 9)}
+    size = {t: sum(h for _, h, _ in ps) / len(ps) for t, ps in teams.items()}
+    stats, games, props = [], [], []
+    gid = 0
+    for d in range(days):
+        day = (date(2025, 10, 22) + timedelta(days=d)).isoformat()
+        order = list(teams); rng.shuffle(order)
+        for i in range(0, 8, 2):
+            h, a = order[i], order[i + 1]; gid += 1
+            games.append({"id": gid, "date": day, "datetime": day + "T23:30:00Z", "season": 2025,
+                          "home_team": {"id": h}, "visitor_team": {"id": a}, "status": "Final", "postseason": False})
+            for team, opp in ((h, a), (a, h)):
+                for pid, hgt, rate in teams[team]:
+                    mins = 28.0
+                    mu = max(0.3, rate * mins + effect * (hgt - size[opp]))
+                    reb = sum(rng.random() < mu / 60 for _ in range(60))
+                    stats.append({"min": "28:00", "pts": 10, "reb": reb, "ast": 2, "fga": 10, "fgm": 4, "fg3a": 3,
+                                  "player": {"id": pid, "height": f"{hgt // 12}-{hgt % 12}", "draft_year": 2018},
+                                  "team": {"id": team}, "game": {"id": gid, "date": day}})
+                    fair_mu = rate * mins + (effect * (hgt - size[opp]) if market_knows_size else 0.0)
+                    line = math.floor(fair_mu) + 0.5
+                    # price the over from a Poisson(fair_mu) so the market is right about what it knows
+                    k = math.floor(line); cdf = sum(math.exp(-fair_mu) * fair_mu ** j / math.factorial(j) for j in range(k + 1))
+                    po = min(max(1 - cdf, 0.05), 0.95)
+                    to_am = lambda p: int(round(-100 * p / (1 - p))) if p >= 0.5 else int(round(100 * (1 - p) / p))
+                    props.append({"game_id": gid, "player_id": pid, "vendor": "draftkings", "prop_type": "rebounds",
+                                  "line_value": str(line), "opened_at": day + "T15:00:00Z",
+                                  "market": {"type": "over_under", "over_odds": to_am(po), "under_odds": to_am(1 - po)}})
+    gated, _, _ = quarantine(props, games, "bdl_opening_player_props")
+    return gated, stats, games, props
+
+
+def test_features_use_only_earlier_games():
+    _, stats, games, _ = league(1, days=30)
+    f1 = build(stats, games)
+    later = [dict(r) for r in stats]
+    last_day = max(r["game"]["date"] for r in later)
+    for r in later:
+        if r["game"]["date"] == last_day:
+            r["reb"] = 99
+    f2 = build(later, games)
+    for k, v in f1.items():
+        assert f2[k] == v  # changing the final day's results changes no feature
+
+
+def test_height_signal_found_when_price_ignores_it_and_not_when_priced():
+    from scripts.feature_info_test import run
+    gated, stats, games, _ = league(2, market_knows_size=False)
+    res = run(gated, stats, games)
+    assert res["results"]["rebounds|height_diff"]["verdict"] == "PASS"
+    gated2, stats2, games2, _ = league(3, market_knows_size=True)
+    res2 = run(gated2, stats2, games2)
+    assert res2["results"]["rebounds|height_diff"]["verdict"] == "FAIL"
+
+
+def test_info_test_refuses_ungated_props():
+    from scripts.feature_info_test import run
+    _, stats, games, raw = league(4, days=20)
+    with pytest.raises(UnverifiedOddsError):
+        run(raw, stats, games)
+
+
+def test_bh_controls_false_discoveries():
+    from scripts.feature_info_test import benjamini_hochberg
+    assert benjamini_hochberg([0.001, 0.2, 0.5, 0.04]) == [True, False, False, True]
+    assert benjamini_hochberg([0.03, 0.2, 0.5, 0.6]) == [False, False, False, False]
diff --git a/v13/matchup_features.py b/v13/matchup_features.py
new file mode 100644
index 0000000..e5a762c
--- /dev/null
+++ b/v13/matchup_features.py
@@ -0,0 +1,123 @@
+"""Pregame player matchup features from box scores only (no new API calls).
+
+Every feature for a player-game uses only games dated strictly before it. Sources:
+  player object nested in /v1/stats rows: height ("6-11"), weight, position, draft_year
+  team-game aggregates built from the same box scores (FGA, FGM, FG3A, minutes).
+
+Features
+  height_in                 player height (inches)
+  opp_size_in               minutes-weighted height of the opponent's top-8 minute players over its last 10 games
+  height_diff               height_in - opp_size_in
+  opp_missed_fg             opponent missed field goals per game, last 10 (defensive-rebound chances)
+  own_missed_fg             own team missed field goals per game, last 10 (offensive-rebound chances)
+  opp_fg3a_rate             opponent 3PA / FGA, last 10 (long rebounds)
+  years_since_draft         season - draft_year (career-stage proxy; BALLDONTLIE has no birth date)
+  b2b                       player's previous game was the day before
+  h2h_resid_<stat>          shrunk mean of (actual - player's 10-game average) in earlier meetings with this
+                            opponent, all seasons supplied; shrinkage k = 5 games
+"""
+from collections import defaultdict, deque
+from datetime import date
+
+from scripts.regular_season_filter import minutes as parse_minutes
+
+H2H_K = 5.0
+STATS = {"points": "pts", "rebounds": "reb", "assists": "ast"}
+
+
+def parse_height(h):
+    try:
+        ft, inch = str(h).split("-")
+        return 12 * int(ft) + int(inch)
+    except (ValueError, AttributeError):
+        return None
+
+
+def _f(r, k):
+    try:
+        return float(r.get(k) or 0)
+    except (TypeError, ValueError):
+        return 0.0
+
+
+def build(stats, games):
+    """(game_id, player_id) -> feature dict, built strictly from earlier games."""
+    gmeta = {str(g["id"]): g for g in games}
+    rows = []
+    for r in stats:
+        g, pl, tm = r.get("game") or {}, r.get("player") or {}, r.get("team") or {}
+        if g.get("id") is None or pl.get("id") is None or tm.get("id") is None:
+            continue
+        gid = str(g["id"]); meta = gmeta.get(gid, {})
+        rows.append({"gid": gid, "date": str(g.get("date") or meta.get("date"))[:10], "season": meta.get("season", g.get("season")),
+                     "pid": str(pl["id"]), "tid": str(tm["id"]), "min": parse_minutes(r.get("min")), "row": r, "pl": pl})
+    rows.sort(key=lambda x: (x["date"], x["gid"]))
+    # opponent per (game, team)
+    teams_in_game = defaultdict(set)
+    for x in rows:
+        teams_in_game[x["gid"]].add(x["tid"])
+    opp = {(gid, t): next(iter(ts - {t}), None) for gid, ts in teams_in_game.items() for t in ts}
+
+    team_hist = defaultdict(lambda: deque(maxlen=10))     # tid -> recent team-game aggregates
+    player_hist = defaultdict(lambda: deque(maxlen=10))   # pid -> recent stat dicts
+    h2h = defaultdict(list)                               # (pid, opp_tid, stat) -> residuals
+    last_date = {}
+    out = {}
+    by_date = defaultdict(list)
+    for x in rows:
+        by_date[x["date"]].append(x)
+    for day in sorted(by_date):
+        today = by_date[day]
+        # 1) features from strictly earlier days
+        for x in today:
+            o = opp.get((x["gid"], x["tid"]))
+            th, oh = list(team_hist[x["tid"]]), list(team_hist[o]) if o else []
+            hgt = parse_height(x["pl"].get("height"))
+            feats = {"height_in": hgt, "years_since_draft": None, "b2b": None}
+            dy = x["pl"].get("draft_year")
+            if dy and x["season"]:
+                feats["years_since_draft"] = int(x["season"]) - int(dy)
+            if x["pid"] in last_date:
+                feats["b2b"] = int((date.fromisoformat(day) - date.fromisoformat(last_date[x["pid"]])).days == 1)
+            if len(oh) >= 5:
+                feats["opp_missed_fg"] = sum(t["fga"] - t["fgm"] for t in oh) / len(oh)
+                feats["opp_fg3a_rate"] = sum(t["fg3a"] for t in oh) / max(1.0, sum(t["fga"] for t in oh))
+                sz = [t["size"] for t in oh if t["size"] is not None]
+                feats["opp_size_in"] = sum(sz) / len(sz) if sz else None
+                if hgt is not None and feats["opp_size_in"] is not None:
+                    feats["height_diff"] = hgt - feats["opp_size_in"]
+            if len(th) >= 5:
+                feats["own_missed_fg"] = sum(t["fga"] - t["fgm"] for t in th) / len(th)
+            ph = list(player_hist[x["pid"]])
+            for name, key in STATS.items():
